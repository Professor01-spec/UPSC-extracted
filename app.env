# =====================================================================
# COMPLETE app.env — every variable the bot code reads, in one place.
# Nothing here is optional-but-forgotten: BOT_TOKEN and DATABASE_URL are
# REQUIRED (the bot will refuse to start without them). Everything else
# has a safe built-in default in config.py, but is listed here anyway so
# you can see and change every single feature's setting without touching
# code — this is what makes it "error-proof": missing this file only
# falls back to defaults, it never crashes a feature silently.
# =====================================================================

# ---- REQUIRED (bot will not start without these two) ----
BOT_TOKEN=8849081660:AAFweN9Bs6zmNz13E8knTD9pzC3bs82ExU8

# STEP A: Railway par "+ New -> Database -> PostgreSQL" add karne ke baad,
# uska connection string yahan paste karo aur postgresql:// ko
# postgresql+asyncpg:// me badal do. Is field ke bina bot bilkul start
# hi nahi hoga (courses/orders/users kahin store nahi honge).
DATABASE_URL=postgresql+asyncpg://PASTE_AFTER_CREATING_POSTGRES

# ---- Admin / control (used by EVERY admin command + order approval) ----
ADMIN_ID=7209486623

# ---- Backup channel gate (mandatory-join feature on /start) ----
BACKUP_CHANNEL=@upscse27

# ---- Contact / Help features ----
HELP_BOT_USERNAME=@csewala_bot
PROFESSOR_CONTACT_LINK=https://t.me/csevala

# ---- Payment flow (gift-card "how to buy" button) ----
PAYMENT_HELP_LINK=https://t.me/paymentformenti

# ---- Mini App (Buy Now buttons, section catalogs) ----
# STEP B: Railway "Settings -> Networking -> Generate Domain" karne ke baad,
# jo URL milega (https://xxxx.up.railway.app) wo yahan paste karo. Agar
# khaali chhodoge, bot khud RAILWAY_PUBLIC_DOMAIN se try karega — lekin
# explicitly bhar dena zyada reliable hai.
WEBAPP_BASE_URL=PASTE_AFTER_GENERATING_DOMAIN

# ---- Server port (Railway apne aap sahi value inject karta hai; is
# default ko chhedna zaroori nahi) ----
PORT=8080
