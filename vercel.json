{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    },
    "api/[...path].py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/api/$1"
    }
  ]
}